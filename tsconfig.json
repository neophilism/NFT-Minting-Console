{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "console/**/*.js",
    "console/**/*.mjs",
    "hardhat.config.cjs",
    "test/**/*.cjs"
  ],
  "exclude": ["artifacts", "cache", "node_modules"]
}

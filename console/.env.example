# Development reference; real secrets belong in the provider's secret manager.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
CHAIN_ID=11155111
RPC_URL=
ADMIN_WALLETS=
EDITOR_WALLETS=
VIEWER_WALLETS=
# Optional durable backend: use a dedicated restricted login, NOT neondb_owner.
# At least one owner is required. See docs/PR09_DURABLE_STORAGE.md.
DATABASE_URL=
# Operations CLI ONLY, in a SEPARATE environment, never the app environment:
# DATABASE_URL_UNPOOLED=<migration credential from secret manager>
# TEST_DATABASE_URL_UNPOOLED=<empty isolated test database>
# NFT_TEST_DISPOSABLE_DATABASE=yes
DEPLOYMENT_FACTORY_ADDRESS=
TRANSFER_VALIDATOR_ADDRESS=
OPENSEA_SIGNED_ZONE=
# PINATA_JWT is used by the separate public release:publish operations CLI.
# OPENSEA_API_KEY is for automated listing, not collection deployment or minting.
# These credentials do not enable private drafting or establish full production acceptance.
PINATA_JWT=
OPENSEA_API_KEY=
# Enable the separate public-only deployment/mint path after migrations and owner/RPC setup.
# HTTPS origin + HTTPS RPC + restricted durable database required. Never private drafts.
# NFT_PUBLIC_LAUNCH=1
# NODE_ENV=production
# NFT_MAINNET_ACK=ethereum-mainnet-real-fees

# Browser-first enrollment: optional alternative to environment wallet allowlists.
# Apply 006_browser_installation.sql first using a separate operator environment.
# Keep ADMIN_WALLETS/EDITOR_WALLETS/VIEWER_WALLETS empty in this mode.
# NFT_SETUP_ENABLED=1
# NFT_SETUP_CODE=<random-32-byte-hex-secret-from-provider-secret-manager>
# See docs/BROWSER_INSTALLATION.md. The setup code is not a wallet key.

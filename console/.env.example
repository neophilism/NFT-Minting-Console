# Development reference only. Copy configuration to a root .env, never commit it.
# Never put wallet private keys, seeds or draft decryption keys here or in chat.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
CHAIN_ID=11155111
# A chain-matching RPC is required for both EOA and ERC-1271 authentication.
RPC_URL=
# Comma-separated public addresses; no wallet may appear in conflicting roles.
ADMIN_WALLETS=
EDITOR_WALLETS=
VIEWER_WALLETS=
# Optional reviewed rehearsal factory. Mainnet deployment remains blocked.
DEPLOYMENT_FACTORY_ADDRESS=
TRANSFER_VALIDATOR_ADDRESS=
OPENSEA_SIGNED_ZONE=
# Backend secret-manager placeholders for later, accepted features.
# Populating these DOES NOT enable public upload, marketplace orders or E2EE.
PINATA_JWT=
OPENSEA_API_KEY=
DATABASE_URL=

{
  "name": "nft-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.20.0",
    "npm": "10.9.3"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build": "npm run compile && npm run check && npm run build:ui",
    "ci": "npm run compile && npm run lint && npm run typecheck && npm test && npm run mint:rehearse && npm run test:crypto && npm run test:publication && npm run test:registry && npm run test:data && npm run test:auth && npm run test:ui:model && npm run security:scan && npm run build",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:integration": "npm run compile && node scripts/run-validator-integration.mjs",
    "start": "node console/server.mjs",
    "check": "node --check console/server.mjs && node --check console/public/app.js && node --check console/auth/core.mjs && node --check console/auth/http.mjs && node --check console/auth/wallet.mjs && node --check console/auth/postgres.mjs && node --check console/auth/rotation.mjs && node --check console/data/pool.mjs && node --check console/data/releases.mjs && node --check console/data/http.mjs && node --check console/data/persistence.mjs",
    "lint": "eslint .",
    "security:scan": "npm audit --audit-level=high --omit=dev",
    "typecheck": "tsc --project tsconfig.json && npm run typecheck:ui",
    "deploy:rehearse": "hardhat run scripts/rehearse-deployments.cjs",
    "test:data": "node --test test-data/*.test.mjs",
    "test:auth": "node --test test-auth/*.test.mjs",
    "test:auth:controls": "node --test test-auth/durable-controls.test.mjs",
    "test:auth:postgres": "node scripts/test-native-postgres.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:auth": "node scripts/migrate-auth.mjs",
    "auth:policy": "node scripts/rotate-auth-policy.mjs",
    "security:profiles": "python3 scripts/check_security_profiles.py",
    "test:security-profiles": "python3 -m unittest discover -s test-security -v",
    "test:safe": "node scripts/run-safe-integration.mjs",
    "build:ui": "vite build",
    "typecheck:ui": "tsc --project tsconfig.ui.json && tsc --project tsconfig.ui-tests.json",
    "test:ui:model": "node --experimental-strip-types --test test-ui/*.test.ts",
    "test:ui:browser": "playwright test -c playwright.config.ts",
    "test:ui": "npm run test:ui:model && npm run test:ui:browser",
    "mint:rehearse": "hardhat run scripts/rehearse-mints.cjs",
    "test:rights:aotv": "node --test test-rights/*.test.mjs",
    "rights:aotv:preflight": "node scripts/check-aotv-rights-release.mjs",
    "companion:aotv:generate": "node scripts/generate-aotv-schedules.mjs",
    "test:marketplace:transport": "node --test test-marketplace/*.test.mjs",
    "test:crypto": "node --test test-crypto/*.test.mjs",
    "test:crypto:browser": "node --test test-crypto/*.browser.mjs",
    "public:verify": "node scripts/verify-public-files.mjs",
    "test:publication": "node --test test-publication/*.test.mjs",
    "test:registry": "node --test registry/pr-contract.test.mjs && node scripts/validate-pr-registry.mjs",
    "public:pin": "node scripts/pin-public-file.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "express": "4.22.3",
    "form-data": "4.0.6",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@noble/hashes": "1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@limitbreak/creator-token-standards": "5.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.9",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@openzeppelin/contracts": "4.8.3",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.10",
    "chai": "4.5.0",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "hardhat": "2.26.5",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.5.8",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript-eslint": "8.71.2",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  }
}
